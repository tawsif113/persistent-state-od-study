+            }
+
+            traceStudy("ORDER_START_POST_RESET");
+        }
+    }
+
+    private static void traceStudy(String event) {
+        if (STUDY_TRACE == null) {
+            return;
+        }
+
+        String pid = ManagementFactory.getRuntimeMXBean().getName();
+
+        try (FileWriter writer = new FileWriter(STUDY_TRACE, true)) {
+            writer.write(
+                    STUDY_PROTOCOL + "," +
+                    pid + "," +
+                    System.currentTimeMillis() + "," +
+                    event + "," +
+                    STUDY_STATE_FILE.exists() +
+                    System.lineSeparator()
+            );
+        } catch (IOException ignored) {
+            // Instrumentation must not affect historical test behavior.
+        }
+    }
