+    File traceFile = new File(STUDY_TRACE_DIR, "trace-${pid}.log")
+
+    traceFile << (
+        "timestamp=${System.currentTimeMillis()}" +
+        ",pid=${pid}" +
+        ",protocol=${STUDY_PROTOCOL}" +
+        ",event=${event}" +
+        ",deployments_exists=${STUDY_DEPLOY_DIR.exists()}" +
+        System.lineSeparator()
+    )
+  }
