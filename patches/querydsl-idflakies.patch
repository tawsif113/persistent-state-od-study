 import java.io.InputStream;
 import java.sql.SQLException;
 import java.util.List;
@@ -33,12 +35,82 @@ import com.querydsl.core.util.FileUtils;
 
 public abstract class AbstractQueryTest {
 
+    /*
+     * Persistent-state study instrumentation.
+     *
+     * clean  -> remove the real Lucene index when a new test-order JVM starts
+     * reused -> preserve the Lucene index across test-order JVM executions
+     *
+     * Historical behavior is unchanged when STUDY_PROTOCOL is unset.
+     */
+    private static final String STUDY_PROTOCOL =
+            System.getenv("STUDY_PROTOCOL");
+
+    private static final String STUDY_TRACE =
+            System.getenv("STUDY_TRACE");
+
+    private static final File STUDY_LUCENE_DIR =
+            new File("target/lucene");
+
+    private static final File STUDY_DERBY_DIR =
+            new File("target/derbydb");
+
+    static {
+        if (STUDY_PROTOCOL != null) {
+            traceStudy("ORDER_START_PRE_RESET");
+
+            if ("clean".equalsIgnoreCase(STUDY_PROTOCOL)) {
+                try {
+                    FileUtils.delete(STUDY_LUCENE_DIR);
+                } catch (IOException e) {
+                    throw new ExceptionInInitializerError(e);
+                }
+            }
+
+            traceStudy("ORDER_START_POST_RESET");
+        }
+    }
+
+    protected static void traceStudy(String event) {
+        if (STUDY_TRACE == null) {
+            return;
+        }
+
+        FileWriter writer = null;
+
+        try {
+            writer = new FileWriter(STUDY_TRACE, true);
+
+            writer.write(
+                    STUDY_PROTOCOL + "," +
+                    ManagementFactory.getRuntimeMXBean().getName() + "," +
+                    System.currentTimeMillis() + "," +
+                    event + "," +
+                    STUDY_LUCENE_DIR.exists() + "," +
+                    STUDY_DERBY_DIR.exists() +
+                    System.getProperty("line.separator")
+            );
+        } catch (IOException ignored) {
+            // Tracing must not alter historical test behavior.
+        } finally {
+            if (writer != null) {
+                try {
+                    writer.close();
+                } catch (IOException ignored) {
+                    // Ignore trace cleanup failures.
+                }
+            }
+        }
+    }
+
     private static SessionFactory sessionFactory;
 
     @BeforeClass
     public static void setUpClass() throws IOException {
+        traceStudy("BEFORE_HISTORICAL_CLEANUP");
         FileUtils.delete(new File("target/derbydb"));
         FileUtils.delete(new File("target/lucene3"));
+        traceStudy("AFTER_HISTORICAL_CLEANUP");
         AnnotationConfiguration cfg = new AnnotationConfiguration();
         cfg.addAnnotatedClass(User.class);
         Properties props = new Properties();
